# ── Build outputs ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Data (too large for git) ─────────────────────────────────────────────────
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep
ML/data/raw/*
!ML/data/raw/.gitkeep
ML/data/processed/*
!ML/data/processed/.gitkeep
ML/data/cache/*
!ML/data/cache/.gitkeep

# ── Model checkpoints ────────────────────────────────────────────────────────
checkpoints/
ML/checkpoints/

# ── Credentials (NEVER commit these) ─────────────────────────────────────────
.env
*.env
credentials*.json
*.token

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── W&B ──────────────────────────────────────────────────────────────────────
wandb/

# ── Ruff / pre-commit caches ──────────────────────────────────────────────────
.ruff_cache/
.pre-commit-cache/

# ── Test coverage ─────────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
